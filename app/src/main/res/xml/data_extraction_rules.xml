<?xml version="1.0" encoding="utf-8"?><!--
  Applies on API 31 and above; backup_rules.xml covers older devices and carries the reasoning for
  backing up only the database.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
